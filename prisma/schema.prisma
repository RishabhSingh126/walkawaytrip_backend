// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid()) // @id marks a field as the primary key and @default sets a default value for a field
  name               String // displayName is a string field
  email              String?   @unique // ? means that the field is optional
  password           String // passwordHash is a string field
  location           String? // ? means that the field is optional
  phone              String? // phone is a string field
  googleId           String?   @unique // ? means that the field is optional
  backgroundImageUrl String? // ? means that the field is optional
  avatarUrl          String? // ? means that the field is optional
  about              String? // ? means that the field is optional
  profileHeadline    String? // ? means that the field is optional
  nationality        String?
  countryCode        String?
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  addressTitle       String?
  verificationToken  String?   @unique // ? means that the field is optional
  verifiedAt         DateTime? // ? means that the field is optional
  isVerified         Boolean   @default(false) // @default sets a default value for a field
  resetToken         String?   @unique // Unique token for password reset
  resetTokenExpiry   DateTime? // Expiry time for the reset token
  bannedAt           DateTime? // ? means that the field is optional
  isBanned           Boolean   @default(false) // @default sets a default value for a field
  deletedAt          DateTime? // ? means that the field is optional
  isDeleted          Boolean   @default(false) // @default sets a default value for a field
  role               Role      @default(USER) // @default sets a default value for a field

  lastLogin DateTime? // ? means that the field is optional
  createdAt DateTime  @default(now()) // @default sets a default value for a field

  @@map("user") // @@map allows you to set the name of the table in the database
}

enum Role {
  USER // USER is a value of the enum
  ADMIN // ADMIN is a value of the enum
}

// BlacklistedToken is a model that represents a token that has been blacklisted
model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  message   String?
  createdAt DateTime @default(now())

  @@map("contacts") // Optional: Name the table as "contacts" in the database
}